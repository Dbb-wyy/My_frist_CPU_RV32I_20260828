@00000000
// === 基础算术逻辑指令测试 ===
00500093   // addi x1, x0, 5      ; x1 = 5
00300113   // addi x2, x0, 3      ; x2 = 3
002081B3   // add  x3, x1, x2     ; x3 = x1 + x2 = 8
40208233   // sub  x4, x1, x2     ; x4 = x1 - x2 = 2
0020E2B3   // or   x5, x1, x2     ; x5 = x1 | x2 = 7
0020F333   // and  x6, x1, x2     ; x6 = x1 & x2 = 1
0020C3B3   // xor  x7, x1, x2     ; x7 = x1 ^ x2 = 6
0020D433   // srl  x8, x1, x2     ; x8 = x1 >> x2 = 0 (5 >> 3)
002094B3   // sll  x9, x1, x2     ; x9 = x1 << x2 = 40 (5 << 3)
4020D533   // sra  x10, x1, x2    ; x10 = x1 >>> x2 = 0

// === 立即数算术指令测试 ===
FF010593   // addi x11, x2, -16    ; x11 = 3 - 16 = -13
00C16593   // ori  x11, x2, 12     ; x11 = 3 | 12 = 15
00C17593   // andi x11, x2, 12     ; x11 = 3 & 12 = 0
00C14593   // xori x11, x2, 12     ; x11 = 3 ^ 12 = 15
00115613   // srli x12, x2, 1      ; x12 = 3 >> 1 = 1
00111693   // slli x13, x2, 1      ; x13 = 3 << 1 = 6
40115713   // srai x14, x2, 1      ; x14 = 3 >>> 1 = 1

// === 存储和加载指令测试 ===
00302023   // sw   x3, 0(x0)       ; mem[0] = 8
00402223   // sw   x4, 4(x0)       ; mem[4] = 2
00502423   // sw   x5, 8(x0)       ; mem[8] = 7
00602623   // sw   x6, 12(x0)      ; mem[12] = 1
00702823   // sw   x7, 16(x0)      ; mem[16] = 6
00802A23   // sw   x8, 20(x0)      ; mem[20] = 0
00902C23   // sw   x9, 24(x0)      ; mem[24] = 40
00A02E23   // sw   x10, 28(x0)     ; mem[28] = 0

// 测试半字和字节存储（使用高地址避免影响之前的测试）
00B12023   // sh   x11, 32(x2)     ; mem[35] = 15 (halfword at address 35)
00C120A3   // sb   x12, 33(x2)     ; mem[33] = 1 (byte at address 33)

// 加载测试
00002303   // lw   x6, 0(x0)       ; x6 = 8 (reload)
00402383   // lw   x7, 4(x0)       ; x7 = 2
00802403   // lw   x8, 8(x0)       ; x8 = 7
00C02483   // lw   x9, 12(x0)      ; x9 = 1
01002503   // lw   x10, 16(x0)     ; x10 = 6
01402583   // lw   x11, 20(x0)     ; x11 = 0
01802603   // lw   x12, 24(x0)     ; x12 = 40

// 半字和字节加载（从高地址加载）
02015683   // lhu  x13, 32(x2)     ; x13 = 15 (unsigned halfword)
02114703   // lbu  x14, 33(x2)     ; x14 = 1 (unsigned byte)

// === 分支和跳转指令测试 ===
00000463   // beq  x0, x0, 8       ; 总是跳转
00000013   // nop (不应该执行)
00100093   // addi x1, x0, 1       ; 不应该执行
0080006F   // jal  x0, 8           ; 跳转到分支测试

// 分支测试
00300E13   // addi x28, x0, 3      ; x28 = 3
00400E93   // addi x29, x0, 4      ; x29 = 4
01DE0E63   // beq  x28, x29, 28    ; 不跳转 (3 != 4)
01DE0863   // beq  x28, x29, 16    ; 不跳转
002E8F33   // add  x30, x29, x2    ; x30 = 4 + 3 = 7
01DE0463   // beq  x28, x29, 8     ; 不跳转
00000F13   // addi x30, x0, 0      ; x30 = 0 (应该执行)

// 不等分支测试
01DE1463   // bne  x28, x29, 8     ; 跳转 (3 != 4)
00000F13   // addi x30, x0, 1      ; 不应该执行
01CE1463   // bne  x28, x14, 8     ; 不跳转 (3 == 3)
00000F13   // addi x30, x0, 2      ; x30 = 2 (应该执行)

// 小于分支测试
01DE4463   // blt  x28, x29, 8     ; 跳转 (3 < 4)
00000F13   // addi x30, x0, 3      ; 不应该执行
01DE8463   // ble  x28, x29, 8     ; 跳转 (3 <= 4)
00000F13   // addi x30, x0, 4      ; 不应该执行
01DE6463   // bltu x28, x29, 8     ; 跳转 (无符号 3 < 4)
00000F13   // addi x30, x0, 5      ; 不应该执行
01DEA463   // bge  x28, x29, 8     ; 不跳转 (3 < 4)
00000F13   // addi x30, x0, 6      ; x30 = 6 (应该执行)

// === 跳转和链接测试 ===
00000097   // auipc x1, 0          ; x1 = PC
010080E7   // jalr  x1, x1, 16     ; 跳转到x1+16，保存返回地址到x1

// === 上层指令测试 ===
FFF00313   // addi x6, x0, -1      ; x6 = 0xFFFFFFFF
00100393   // addi x7, x0, 1       ; x7 = 1
0063E433   // sltu x8, x7, x6      ; x8 = 1 (无符号 1 < 0xFFFFFFFF)
0063A433   // slt  x9, x7, x6      ; x9 = 0 (有符号 1 > -1)

// === LUI测试 ===
123450B7   // lui  x1, 0x12345     ; x1 = 0x12345000
00A08093   // addi x1, x1, 10      ; x1 = 0x1234500A

// === 最终结果存储 ===
00302023   // sw   x3, 0(x0)       ; mem[0] = 8 (最终)
01E02423   // sw   x30, 8(x0)      ; mem[8] = 6 (分支测试结果)
00102623   // sw   x1, 12(x0)      ; mem[12] = 0x1234500A

0000006F   // 无限循环
